FROM node:20-alpine
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

# Install deps (cached layer)
COPY package.json ./
# Copy lockfile if it exists (won't fail if missing)
COPY pnpm-lock.yaml* ./
RUN pnpm install

EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173"]
